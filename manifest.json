{
    "manifest_version": 3,
    "name": "划词翻译小助手",
    "version": "1.1",
    "description": "选中文字后弹出翻译卡片",
    "permissions":[],
    "host_permissions":[
        "https://api.mymemory.translated.net/*"
    ],
    "content_scripts":[
        {
            "matches":["<all_urls>"],
            "js":["content.js"],
            "css":["style.css"]
        }
    ]
}