{
    "manifest_version": 3,
    "name": "划词翻译小助手",
    "version": "1.1",
    "description": "选中文字后弹出翻译卡片",
    "permissions":[],
    "host_permissions":[
        "http://localhost:3001/*",
        "http://127.0.0.1:3001/*",
        "https://localhost:3001/*",
        "https://127.0.0.1:3001/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts":[
        {
            "matches":["<all_urls>"],
            "js":["content.js"],
            "css":["style.css"]
        }
    ]
}